# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/invoice_studio

# Email Configuration (SMTP)
# Replace with your actual SMTP credentials (e.g. Gmail, Mailgun, SendGrid, Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=billing@invoicestudio.app
SMTP_FROM_NAME=Invoice Studio
SMTP_USE_TLS=true

